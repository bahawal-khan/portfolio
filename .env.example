GROQ_API_KEY=
DATABASE_URL=
LANGSMITH_API_KEY=
LANGSMITH_TRACING=
LANGSMITH_PROJECT=

# Backend (FastAPI): allowed browser origin(s) for the chat widget, comma-separated.
CORS_ORIGINS=http://localhost:3000

# Backend (FastAPI): set true in production (served over HTTPS) so the
# thread-id cookie is only ever sent over TLS.
COOKIE_SECURE=false

# Backend (FastAPI): SMTP credentials for the contact-request ("email HITL")
# tool — portfolio-guidance/email_feature.md.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Frontend (Next.js): where the browser reaches the FastAPI backend.
NEXT_PUBLIC_API_URL=http://localhost:8001
